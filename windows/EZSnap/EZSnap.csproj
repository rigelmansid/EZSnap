<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 10 自带 .NET Framework 4.8，不用另装运行时（D-11）。在 macOS 上也能编译（跑不了）。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>EZSnap</AssemblyName>
    <RootNamespace>EZSnap</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <Product>EZSnap</Product>
    <Description>EZSnap 截图</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="AppIcon.ico" LogicalName="EZSnap.AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
